CONFIG_ARM_MPU=y
CONFIG_GPIO=y

# The board has no UART pins; the console goes over RTT on the SWD cable.
CONFIG_CONSOLE=y
CONFIG_SERIAL=n
CONFIG_UART_CONSOLE=n
CONFIG_USE_SEGGER_RTT=y
CONFIG_RTT_CONSOLE=y

# 32.768 kHz crystal Y2 is fitted (measured +27 ppm vs. the 32 MHz crystal).
CONFIG_CLOCK_CONTROL_NRF_K32SRC_XTAL=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_50PPM=y
